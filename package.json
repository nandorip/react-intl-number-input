{
  "name": "react-intl-number-input",
  "version": "0.8.5",
  "description": "A React component for masked and formatted number input.",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "test": "jest --runInBand",
    "dev": "node scripts/demo.mjs",
    "start": "node scripts/demo.mjs",
    "transpile": "npm run build:lib",
    "build:cjs": "tsc",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:lib": "npm run build:cjs && npm run build:esm && node -e \"require('fs').writeFileSync('dist/esm/package.json', '{\\\"type\\\": \\\"module\\\"}')\"",
    "prepublishOnly": "npm test && npm run build:lib",
    "build": "node scripts/demo.mjs --production",
    "deploy": "gh-pages -d example/dist",
    "publish-demo": "npm run build && npm run deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandorip/react-intl-number-input.git"
  },
  "keywords": [
    "react",
    "react-component",
    "javascript",
    "mask",
    "currency",
    "money",
    "number",
    "intl",
    "input",
    "typescript"
  ],
  "author": "Fernando Pires Reherman <nandorip@live.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nandorip/react-intl-number-input/issues"
  },
  "homepage": "https://github.com/nandorip/react-intl-number-input#readme",
  "peerDependencies": {
    "react": ">=16.8.0 <20"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "gh-pages": "^6.3.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
