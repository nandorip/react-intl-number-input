{
  "name": "react-intl-number-input",
  "version": "0.5.1",
  "description": "A React component for masked and formatted number input.",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest --runInBand",
    "start": "webpack serve --mode development",
    "transpile": "babel src -d dist --copy-files --no-copy-ignored --ignore \"**/*.test.jsx\"",
    "prepublishOnly": "npm run transpile",
    "build": "webpack --mode production",
    "deploy": "gh-pages -d example/dist",
    "publish-demo": "npm run build && npm run deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandorip/react-intl-number-input.git"
  },
  "keywords": [
    "react",
    "react-component",
    "javascript",
    "mask",
    "currency",
    "money",
    "number",
    "intl",
    "input"
  ],
  "author": "Fernando Pires Reherman <nandorip@live.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nandorip/react-intl-number-input/issues"
  },
  "homepage": "https://github.com/nandorip/react-intl-number-input#readme",
  "peerDependencies": {
    "react": ">=16.8.0 <20",
    "react-dom": ">=16.8.0 <20"
  },
  "dependencies": {
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.27.2",
    "@babel/core": "^7.27.4",
    "@babel/plugin-transform-object-rest-spread": "^7.28.4",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.27.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "babel-jest": "^30.2.0",
    "babel-loader": "^10.0.0",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.6.4",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.4"
  },
  "overrides": {
    "fast-uri": "^3.1.1",
    "follow-redirects": "^1.16.0",
    "uuid": "^11.1.1"
  }
}
