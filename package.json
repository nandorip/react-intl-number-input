{
  "name": "react-intl-number-input",
  "version": "0.6.0",
  "description": "A React component for masked and formatted number input.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "jest --runInBand",
    "start": "webpack serve --mode development",
    "transpile": "babel src -d dist --extensions \".ts,.tsx\" --ignore \"**/*.test.ts\" --ignore \"**/*.test.tsx\"",
    "build:types": "tsc --emitDeclarationOnly",
    "prepublishOnly": "npm test && npm run transpile && npm run build:types",
    "build": "webpack --mode production",
    "deploy": "gh-pages -d example/dist",
    "publish-demo": "npm run build && npm run deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nandorip/react-intl-number-input.git"
  },
  "keywords": [
    "react",
    "react-component",
    "javascript",
    "mask",
    "currency",
    "money",
    "number",
    "intl",
    "input",
    "typescript"
  ],
  "author": "Fernando Pires Reherman <nandorip@live.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nandorip/react-intl-number-input/issues"
  },
  "homepage": "https://github.com/nandorip/react-intl-number-input#readme",
  "peerDependencies": {
    "react": ">=16.8.0 <20"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-object-rest-spread": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.1.1",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.5"
  },
  "overrides": {
    "fast-uri": "^3.1.1",
    "follow-redirects": "^1.16.0",
    "js-yaml": "^4.1.1",
    "uuid": "^11.1.1"
  }
}
